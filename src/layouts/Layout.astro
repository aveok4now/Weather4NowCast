---
import BaseHead from "../components/server/BaseHead.astro";
import Header from "../components/server/Header.astro";
import Body from "../components/server/Body.astro";
import Footer from "../components/server/Footer.astro";
import { SITE_DESCRIPTION } from "../config";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={SITE_DESCRIPTION} />
	</head>
	<Header />
	<Body>
		<slot />
	</Body>
	<Footer />
</html>
