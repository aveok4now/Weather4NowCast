---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE } from "../config";
import Content from "../components/Content.astro";
import Masthead from "../components/Masthead.astro";
import {
	getForecastForMainCities,
} from "../services/weatherService";
import { MarqueeWeatherCards } from "../components/MarqueeeWeatherCards";
import { hydrateWeatherForeCastOfMainCities } from "../hydrators/weatherHydrator";
import CityForeCastCard from "../components/CityForeCastCard.astro";

const weatherForeCastForMainCities = await getForecastForMainCities();
const mainCitiesWeather = weatherForeCastForMainCities.map(
	hydrateWeatherForeCastOfMainCities
);
---

<Layout title={SITE_TITLE}>
	<CityForeCastCard />
	<Masthead />
	<Content />
	<MarqueeWeatherCards client:load weatherData={mainCitiesWeather} />
</Layout>

<script src="../scripts/weather-forecast.ts"></script>
