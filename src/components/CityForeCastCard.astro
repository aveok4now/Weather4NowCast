---
import { cn } from "../lib/utils";
import { MagicCard, MagicContainer } from "./Card";
import DotPattern from "./DotPattern";
import { FadeText } from "../components/FadeText";
import { motion } from "framer-motion";

const weatherDetails = [
	{ title: "Ощущается как", id: "feels-like" },
	{ title: "Влажность", id: "humidity" },
	{ title: "Ветер", id: "wind" },
	{ title: "Давление", id: "pressure" },
	{ title: "Время заката", id: "sunset" },
];
---

<MagicContainer
	className="w-full h-auto z-30 grid grid-cols-1 md:grid-cols-5 gap-4 p-4"
>
	{
		weatherDetails.map((detail) => (
			<MagicCard
				borderWidth={2}
				className="flex flex-col items-center justify-center p-4 shadow-2xl overflow-hidden"
			>
				<DotPattern
					className={cn(
						"absolute inset-0 h-full w-full [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
					)}
				/>
				<FadeText
					className="text-lg font-bold"
					direction="up"
					framerProps={{
						show: { transition: { delay: 0.2 } },
					}}
					text={detail.title}
					client:load
				/>
				<motion.p
					id={detail.id}
					key={detail.id}
					className="origin-center drop-shadow-sm text-2xl font-bold"
					initial="hidden"
					animate="visible"
					exit="hidden"
					transition={{ duration: 0.5, delay: Number(detail.id) * 0.08 }}
					variants={{
						hidden: { rotateX: -90, opacity: 0 },
						visible: { rotateX: 0, opacity: 1 },
					}}
					client:load
				>
					-
				</motion.p>
			</MagicCard>
		))
	}
</MagicContainer>
