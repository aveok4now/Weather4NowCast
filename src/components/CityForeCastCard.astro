---
import { cn } from "../lib/utils";
import { MagicCard, MagicContainer } from "./Card";
import DotPattern from "./DotPattern";
---

<MagicContainer className={"w-full h-80 z-30 "}>
	<MagicCard
		borderWidth={0}
		className="flex w-full cursor-pointer flex-col items-center justify-center overflow-hiddenbg-[radial-gradient(var(--mask-size)_circle_at_var(--mouse-x)_var(--mouse-y),#ffaa40_0,#9c40ff_50%,transparent_100%)]  p-20 shadow-2xl "
	>
		<DotPattern
			className={cn(
				"[mask-image:radial-gradient(200px_circle_at_center,white,transparent)]"
			)}
		/>
		<p
			class="z-10 whitespace-nowrap text-4xl font-medium text-gray-800 dark:text-gray-200"
		>
			Magic
		</p>
		<div
			class="pointer-events-none absolute inset-0 h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(0,255,255,0))]"
		>
		</div>
	</MagicCard>
</MagicContainer>
