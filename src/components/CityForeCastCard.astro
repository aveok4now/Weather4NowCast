---
import { cn } from "../lib/utils";
import { MagicCard, MagicContainer } from "./Card";
import DotPattern from "./DotPattern";
import { FadeText } from "../components/FadeText";
import { motion } from "framer-motion";
import { BorderBeam } from "../components/BorderBeam";
import { WEATHER_OPTIONS as weatherOptions } from "../config";
---

<MagicContainer
	className=`w-full h-auto z-30 grid grid-cols-1 md:grid-cols-5 gap-4 p-4`
	id="weatherContainer"
>
	{
		weatherOptions.map((option) => (
			<MagicCard
				borderWidth={2}
				className="hidden flex-col items-center justify-center p-4 shadow-2xl overflow-hidden weather-card"
				data-id={option.id}
			>
				<BorderBeam colorFrom="rgb(219 234 254)" colorTo="rgb(37 99 235)"/>
				<DotPattern
					className={cn(
						"absolute inset-0 h-full w-full [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
					)}
				/>
				<FadeText
					className="text-lg font-light"
					direction="up"
					framerProps={{
						show: { transition: { delay: 0.2 } },
					}}
					text={option.title}
					client:load
				/>
				<motion.p
					id={option.id}
					key={option.id}
					className="origin-center drop-shadow-sm text-2xl font-bold"
					initial="hidden"
					animate="visible"
					exit="hidden"
					transition={{ duration: 0.5, delay: Number(option.id) * 0.08 }}
					variants={{
						hidden: { rotateX: -90, opacity: 0 },
						visible: { rotateX: 0, opacity: 1 },
					}}
					client:load
				>
					-
				</motion.p>
			</MagicCard>
		))
	}
</MagicContainer>

<script>
	function updateWeatherCards() {
		const container = document.getElementById("weatherContainer");
		if (!container) return;

		const cards = container.getElementsByClassName("weather-card");
		const settings = JSON.parse(
			localStorage.getItem("weatherSettings") || "{}"
		);

		let visibleCards = 0;

		Array.from(cards).forEach((element) => {
			if (element instanceof HTMLElement) {
				const card = element;
				const id = card.dataset.id;
				if (id && settings[id]) {
					card.style.display = "flex";
					visibleCards++;
				} else {
					card.style.display = "none";
				}
			}
		});

		container.style.display = visibleCards === 0 ? "none" : "grid";
		updateGridColumns(container, visibleCards);
	}

	function updateGridColumns(container: any, visibleCards: number) {
		container.classList.remove(...container.classList);
		container.classList.add("w-full", "h-auto", "z-30", "grid", "gap-4", "p-4");

		const gridColumnClass = `md:grid-cols-${visibleCards > 0 ? visibleCards : 1}`;
		container.classList.add(gridColumnClass);
	}

	window.addEventListener("weatherSettingsChanged", updateWeatherCards);
	document.addEventListener("DOMContentLoaded", updateWeatherCards);
</script>
