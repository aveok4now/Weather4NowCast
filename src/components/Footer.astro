---
import { AUTHOR_GH_LINK, AUTHOR_NAME } from "../config";
import TypeWriter from "./TypeWriter";

const footerWords = [
    "Weather forecast",
    "CDG",
    "Sevastopol"
];
---

<footer class="text-center text-zinc-500 p-4">
    &copy; {new Date().getFullYear()}
    <a href={AUTHOR_GH_LINK}>{AUTHOR_NAME}</a>. All rights reserved.
		<code
			class="leading-tight text-xs hover:text-black dark:hover:text-white transition-colors duration-700"
		>
			<TypeWriter
				words={footerWords}
				loop={false}
				typeSpeed={100}
				deleteSpeed={25}
				client:visible
			/>
		</code>
	</a>
</footer>