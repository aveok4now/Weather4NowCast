---
import Particles from "../client/magic/Particles";
import { YANDEX_MAPS_URL } from "../../config";
import SearchInput from "../client/inputs/SearchInput"

interface Props {
	video?: string;
	className?: string;
	city?: string;
	temperature?: number;
}

const {
	video = "/video/sunny_weather.mp4",
	className,
	city = "",
	temperature = "",
} = Astro.props;
---

<main class="min-w-screen z-50 rounded-3xl">
	<section class="relative h-80 flex justify-center items-center">
		<div class="absolute w-full h-full overflow-hidden">
			<Particles client:load staticity={15} size={0.6} />
			<video
				class=`absolute h-auto left-1/2 top-1/2 min-w-full min-h-full object-cover -translate-x-1/2 -translate-y-1/2 opacity-50 dark:opacity-30 ${className}`
				autoplay="autoplay"
				muted="muted"
				loop="loop"
				playsinline><source src={video} type="video/mp4" /></video
			>
		</div>
		<div
			class="z-10 text-center px-8 drop-shadow-lg shadow-black backdrop-blur-xs w-full mt-10"
		>
			<div
				id="city"
				class="uppercase text-4xl text-center font-extrabold animate-slidein text-white"
			>
				{city}
			</div>

			<div class="text-2xl font-medium">
				<span
					id="temperature"
					class="font-light text-white dark:text-blue-300 animate-slidein text-3xl"
				>
					{temperature && `${temperature} °C`}
				</span>
			</div>
			<a
				href="#"
				id="coordinates-link"
				class="text-gray-200 dark:text-gray-400 hover:underline cursor-pointer"
			>
				<span id="coordinates"></span>
			</a>
			
			<div class="mt-10 z-50">
				<SearchInput client:load />
			</div>
			
		</div>
		
	</section>
</main>

<script is:inline define:vars={{ YANDEX_MAPS_URL }}>
	function updateCoordinatesLink() {
		const coordinatesElement = document.getElementById("coordinates");
		const coordinatesLink = document.getElementById("coordinates-link");

		if (coordinatesElement && coordinatesLink) {
			const coordinates = coordinatesElement.textContent;
			if (coordinates) {
				const [lat, lon] = coordinates.split(", ");
				const url = `${YANDEX_MAPS_URL}?ll=${lon}%2C${lat}`;
				coordinatesLink.href = url;
			}
		}
	}

	document.addEventListener("DOMContentLoaded", updateCoordinatesLink);

	const observer = new MutationObserver(updateCoordinatesLink);
	const coordinatesElement = document.getElementById("coordinates");
	if (coordinatesElement) {
		observer.observe(coordinatesElement, {
			childList: true,
			characterData: true,
			subtree: true,
		});
	}
</script>
