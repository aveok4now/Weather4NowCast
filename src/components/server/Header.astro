---
import { SITE_TITLE } from "../../config";
import { DropdownMenu } from "../client/toggles/DropdownMenu";
import { ThemeToggle } from "../client/toggles/ThemeToggle";
import {WeatherSettingsToggle} from "../client/toggles/WeatherSettingsToggle"
---

<header class="bg-transparent backdrop-blur-3xl fixed w-full z-50 p-3">
	<div class="mx-auto max-w-3xl">
		<nav class="flex items-center gap-4">
			<a
				href="/"
				class="text-white dark:text-blue-300 tracking-tight font-black uppercase cursor-pointer"
			>
				{SITE_TITLE}</a
			>
			<div class="flex-1"></div>
			<ThemeToggle client:idle />
			<WeatherSettingsToggle client:idle/>
			<DropdownMenu client:idle/>
		</nav>
	</div>
</header>
