---
import { cn } from "../../lib/utils";
import { MagicCard, MagicContainer } from "../client/magic/Card";
import DotPattern from "../client/magic/DotPattern";
import { FadeText } from "../client/text/FadeText";
import { motion } from "framer-motion";
import { BorderBeam } from "../client/magic/BorderBeam";
import { WEATHER_OPTIONS as weatherOptions } from "../../config";
import ShinyButton from "../client/magic/ShinyButton";
---

<MagicContainer
	className=`w-full h-auto z-30 grid gap-4 p-4`
	id="weatherContainer"
>
	{
		weatherOptions.map((option) => (
			<MagicCard
				borderWidth={2}
				className="bg-blue-400 hidden flex-col items-center justify-center p-4 shadow-2xl overflow-hidden weather-card"
				data-id={option.id}
			>
				<BorderBeam colorFrom="rgb(219 234 254)" colorTo="rgb(37 99 235)" />
				<DotPattern
					className={cn(
						"absolute inset-0 h-full w-full [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
					)}
				/>
				<FadeText
					className="text-lg font-light"
					direction="up"
					framerProps={{
						show: { transition: { delay: 0.2 } },
					}}
					text={option.title}
					client:load
				/>
				<motion.p
					id={option.id}
					key={option.id}
					className="origin-center drop-shadow-sm text-2xl font-bold"
					initial="hidden"
					animate="visible"
					exit="hidden"
					transition={{ duration: 0.5, delay: Number(option.id) * 0.08 }}
					variants={{
						hidden: { rotateX: -90, opacity: 0 },
						visible: { rotateX: 0, opacity: 1 },
					}}
					client:load
				>
					-
				</motion.p>
			</MagicCard>
		))
	}
	<div class="flex items-center justify-center">
		<ShinyButton text="Сохранить город" id="saveCityButton" client:visible />
	</div>
	<div
		id="savedCitiesContainer"
		class="flex flex-wrap justify-start md:justify-center gap-2  text-black relative"
	>
	</div>
</MagicContainer>

<script>
	import { updateSavedCitiesList } from "../../services/savedCitiesService.ts";

	document.addEventListener("DOMContentLoaded", () => {
		updateSavedCitiesList("savedCitiesContainer");
		updateWeatherCards();
	});

	function updateWeatherCards() {
		const container = document.getElementById("weatherContainer");
		if (!container) return;

		const cards = container.getElementsByClassName("weather-card");
		const settings = JSON.parse(
			localStorage.getItem("weatherSettings") || "{}"
		);

		let visibleCards = 0;

		Array.from(cards).forEach((element) => {
			if (element instanceof HTMLElement) {
				const card = element;
				const id = card.dataset.id;
				if (id && settings[id]) {
					card.style.display = "flex";
					visibleCards++;
				} else {
					card.style.display = "none";
				}
			}
		});

		container.style.display = visibleCards === 0 ? "none" : "grid";
		updateGridColumns(container, visibleCards);
	}

	function updateGridColumns(container: HTMLElement, visibleCards: number) {
		container.classList.remove(...container.classList);
		container.classList.add("w-full", "h-auto", "z-30", "grid", "gap-4", "p-4");

		if (visibleCards > 1) {
			const gridColumnClass = `grid-cols-1 md:grid-cols-${Math.min(visibleCards, 5)}`;
			container.classList.add(...gridColumnClass.split(" "));
		} else {
			container.classList.add("grid-cols-1");
		}
	}

	window.addEventListener("weatherSettingsChanged", updateWeatherCards);
</script>
