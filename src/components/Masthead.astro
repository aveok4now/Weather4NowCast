---
import { DEFAULT_CITY } from "../config";

interface Props {
	video?: string;
	className?: string;
	city?: string;
	temperature: number;
}

const {
	video = "/video/sunny_weather.mp4",
	className,
	city = DEFAULT_CITY,
	temperature,
} = Astro.props;
---

<main class="pt-14 min-w-screen">
	<section class="relative h-80 flex justify-center items-center">
		<div class="absolute w-full h-full overflow-hidden">
			<video
				class=`absolute h-auto left-1/2 top-1/2 min-w-full min-h-full object-cover -translate-x-1/2 -translate-y-1/2 opacity-50 dark:opacity-30 ${className}`
				autoplay="autoplay"
				muted="muted"
				loop="loop"
				playsinline><source src={video} type="video/mp4" /></video
			>
		</div>
		<div
			class="z-10 text-center px-8 drop-shadow-lg shadow-black backdrop-blur-xs"
		>
			<div
				id="city"
				class="uppercase text-4xl text-center font-extrabold animate-slidein text-white"
			>
				{city}
			</div>

			<div class="text-2xl font-medium">
				<span
					id="temperature"
					class="font-light text-white dark:text-blue-300 animate-slidein text-3xl"
				>
					{temperature} °C
				</span>
			</div>
		</div>
	</section>
</main>
